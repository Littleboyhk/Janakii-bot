# ==========================================
# Telegram Movie Librarian Bot Configuration
# ==========================================

# 1. Telegram Bot Token (obtain from @BotFather on Telegram)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. MongoDB Connection URI (Local MongoDB or MongoDB Atlas Cloud)
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017

# Database name inside MongoDB
DATABASE_NAME=movie_librarian

# 3. Force Subscribe Channel ID (Anti-Spam / Verification)
# Can be a numerical ID (e.g., -1001234567890) or public username (e.g., @MyMovieChannel)
# Note: The bot MUST be added as an Administrator to this channel!
FORCE_SUB_CHANNEL_ID=-1001234567890

# Optional: Channel invite link (useful if the channel is private, e.g., https://t.me/+AbCdEfGh)
# If left empty, public link https://t.me/<username> will be inferred if username is provided.
FORCE_SUB_CHANNEL_LINK=https://t.me/MyMovieChannel

# 4. Auto-Delete Timer in seconds (Default: 300 seconds = 5 minutes)
AUTO_DELETE_SECONDS=300

# 5. Search Rate Limit / Cooldown in seconds per user (Default: 3 seconds)
SEARCH_COOLDOWN_SECONDS=3

# 6. Pagination Page Size (Default: 10 results per page)
RESULTS_PER_PAGE=10

# 7. Admin Telegram User IDs (comma-separated, e.g., 123456789,987654321)
# Admins can use the bot listener in add_movie.py or special admin commands
ADMIN_USER_IDS=123456789
